      "name": "API 1 - Create or Get Chat",
      "item": [
        {
          "name": "Create or Get Chat (Valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": 1,\n  \"userBId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/create",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "create"]
            }
          }
        },
        {
          "name": "Duplicate Chat Retrieval (Reverse IDs)",
          "request": {
            "method": "POST",
