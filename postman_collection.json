    {
      "name": "API 3 - Get Messages",
      "item": [
        {
          "name": "Get Messages (Chronological Order)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get Messages with Pagination (limit=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get Next Page with Cursor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=10&cursor={{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "cursor",
                  "value": "{{messageId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Error - Invalid Limit (> 100)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=150",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "150"
                }
              ]
            }
          }
        }
      ]
    },
