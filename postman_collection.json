            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": 1,\n  \"text\": \"   \"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "message", "send"]
            }
          }
        },
        {
          "name": "Error - Unauthorized Sender (Not a Participant)",
          "request": {
            "method": "POST",
            "header": [
