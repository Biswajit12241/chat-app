    {
      "name": "API 2 - Send Message",
      "item": [
        {
          "name": "Send Message (Valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": 1,\n  \"text\": \"Hello, how are you?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "message", "send"]
